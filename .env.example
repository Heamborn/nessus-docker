# 复制成 .env 后按需修改，docker compose 会自动读取
#   cp .env.example .env

# 首次启动自动注册用的激活码（一次性，绑定实例）
# 留空则实例停在未注册状态：能导入编译，但收尾会被清空，等于白跑
ACTIVATION_CODE=

# 引擎版本
NESSUS_VERSION=10.12.6

# 基础镜像：拉不动 Docker Hub 时就换成下面这行
BASE_IMAGE=ubuntu:22.04
# BASE_IMAGE=public.ecr.aws/docker/library/ubuntu:22.04

# 宿主机端口
HOST_PORT=8834
